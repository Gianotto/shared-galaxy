# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Savegames e resultados de experimento: arquivo pessoal, não entra no repo.
# O roteiro em docs/trade-experiment.md fica; o que sai dele, não.
experiments/snapshots/
experiments/*.json
!experiments/README.md

# Backups que as ferramentas criam ao gravar um save
*.bak-*

# Segredos e configuração local do servidor
.env
*.local.yml

# Build do mod: sai de mod/build.sh, e o jar carrega bytecode do jogo no
# classpath de compilação. Fonte e receita ficam versionados; o binário não.
mod/build/

# Binário do cliente: sai de client/build.sh e do CI. O fonte é que é a verdade.
client/dist/

# Caches de ferramenta. Nenhum deles existe hoje no repositório; estão aqui
# para não passarem a existir sem alguém reparar.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
build/
dist/

# Editores
.vscode/
.idea/
*.swp

# Sistema operacional
.DS_Store
Thumbs.db

# Saídas de execução: log do cliente, save empacotado, pasta de sala baixada.
# Um zip de save é a partida de alguém; commitá-lo por engano publicaria o
# jogo de uma pessoa num repositório aberto.
*.log
*.zip
savegames/
sharedgalaxy.log
sharedgalaxy.ships
sharedgalaxy.shop

# Configuração desta instalação: nginx, túnel e o passo a passo com o domínio
# e os caminhos da máquina onde isto roda. Os arquivos continuam no disco de
# quem hospeda, e a topologia está descrita em deploy/README.md sem nomear
# servidor nenhum.
deploy/*.conf
deploy/cloudflared-ingress.txt
deploy/APLICAR.md
deploy/local.env

# Qual versão o site anuncia nos botões de download. O deploy escreve a partir
# da tag; versionar isso deixaria o arquivo mentir entre uma tag e a próxima.
server/web/CLIENT_VERSION

# Carimbo de versão do cliente. Os dois builds o escrevem a partir da tag;
# versionado, ele mentiria entre uma tag e a próxima.
tools/_version.py
