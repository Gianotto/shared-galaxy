<aspectj>
    <aspects>
        <aspect name="com.sharedgalaxy.AutoLoadAspect"/>
        <aspect name="com.sharedgalaxy.ShopButtonAspect"/>
        <aspect name="com.sharedgalaxy.QuietNeighbourAspect"/>
    </aspects>

    <!-- Weaving costs startup time on every class named here, so this names
         exactly one. The aspect only ever needs the main menu's update loop. -->
    <weaver options="-Xlint:ignore">
        <include within="fi.bugbyte.spacehaven.gui.menu.GameMenu"/>
        <include within="fi.bugbyte.spacehaven.gui.GUI"/>
        <include within="fi.bugbyte.spacehaven.gui.MenuSystemItems$SingleWorldElementSelected"/>
        <include within="fi.bugbyte.spacehaven.ai.Communication"/>
        <include within="fi.bugbyte.spacehaven.gui.MenuSystem$SelectionBox"/>
        <include within="com.sharedgalaxy.*"/>
    </weaver>
</aspectj>
