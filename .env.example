# Copie para `.env` e edite antes do primeiro `docker compose up`.

# Obrigatório. O compose recusa subir sem isto.
POSTGRES_PASSWORD=troque-esta-senha

# Opcionais, com padrão razoável.
# POSTGRES_DB=sgalaxy
# POSTGRES_USER=sgalaxy
# SGALAXY_PORT=8714

# Deixe vazio para sala aberta. Preencha para exigir convite na criação de
# conta — é o freio se o abuso aparecer, e o modo natural de um servidor
# privado de um grupo de amigos.
# SGALAXY_INVITE_ONLY=
