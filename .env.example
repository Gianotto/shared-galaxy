# Copie para `.env` e edite antes do primeiro `docker compose up`.

# Obrigatório. O compose recusa subir sem isto.
POSTGRES_PASSWORD=troque-esta-senha

# Opcionais, com padrão razoável.
# POSTGRES_DB=sgalaxy
# POSTGRES_USER=sgalaxy
# SGALAXY_PORT=8714

# Onde a API escuta. O padrão é só o loopback: exponha com proxy reverso na
# frente, e mude isto só se souber por quê.
# SGALAXY_BIND=127.0.0.1

# Deixe vazio para sala aberta. Preencha para exigir convite na criação de
# conta — é o freio se o abuso aparecer, e o modo natural de um servidor
# privado de um grupo de amigos.
# SGALAXY_INVITE_ONLY=

# --- limites, todos opcionais ---------------------------------------------
# Convite obrigatório para criar conta. Vazio deixa o cadastro aberto.
SGALAXY_INVITE_ONLY=
# Segredo do HMAC de endereço. SEM ELE NÃO HÁ LIMITE POR ENDEREÇO: preferimos
# cadastro aberto a guardar endereço de gente em claro. Gere com:
#   openssl rand -hex 32
SGALAXY_IP_PEPPER=
# Quantas contas por endereço. Uma casa ou um alojamento precisa de mais.
SGALAXY_MAX_PER_IP=1
# Quantas galáxias uma conta pode ter ao mesmo tempo.
SGALAXY_MAX_GALAXIES=1
